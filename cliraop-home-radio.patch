+			if (n >= 4) {
+				raopcl_send_chunk(raopcl, buf, n / 4, &playtime);
+				frames += n / 4;
+			}
+			if (r <= 0) {
+				/* home-radio patch: input ended - let the buffer play out, then quit (was: spin forever) */
+				usleep(TS2MS(latency, raopcl_sample_rate(raopcl)) * 1000);
+				break;
+			}
+		} else {
